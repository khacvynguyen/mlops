pipeline {
  agent { label 'mlops-agent' }

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
  }

  environment {
    PROJECT_ID                = 'mlops-476305'
    REGION                    = 'asia-southeast1'
    REPO                      = 'asia-southeast1-docker.pkg.dev/mlops-476305/my-mlops'
    BACKEND_IMAGE_REPO        = "$REPO/llm-backend"
    FRONTEND_IMAGE_REPO       = "$REPO/llm-frontend"
    CLUSTER_NAME              = 'mlops-cluster'
    CLUSTER_LOCATION          = 'asia-southeast1'
    TERRAFORM_VERSION         = '1.13.4'
    BACKEND_REPLICAS          = '1'
    FRONTEND_REPLICAS         = '1'
    OAUTH2_REPLICAS           = '1'
    CLOUDSDK_CORE_DISABLE_PROMPTS = '1'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.IMAGE_TAG = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
        }
      }
    }

    stage('Setup Tooling') {
      steps {
        container('ci') {
          sh '''#!/bin/bash
            set -euxo pipefail
            apt-get update
            apt-get install -y --no-install-recommends \
              python3 python3-venv python3-pip unzip curl gnupg lsb-release \
              kubectl google-cloud-cli-gke-gcloud-auth-plugin
            curl -fsSLo terraform.zip https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip
            unzip -o terraform.zip -d /usr/local/bin
            rm terraform.zip
          '''
        }
      }
    }

    // stage('Authenticate GCP') {
    //   steps {
    //     container('ci') {
    //       script {
    //         withCredentials([file(credentialsId: 'gcp-sa', variable: 'GCP_SA_JSON')]) {
    //           sh '''#!/bin/bash
    //             set -euxo pipefail
    //             cp "$GCP_SA_JSON" ${WORKSPACE}/sa.json
    //             export GOOGLE_APPLICATION_CREDENTIALS=${WORKSPACE}/sa.json
    //             gcloud auth activate-service-account --key-file=${WORKSPACE}/sa.json
    //             gcloud config set project $PROJECT_ID
    //             gcloud auth configure-docker ${REGION}-docker.pkg.dev --quiet
    //             gcloud components install kubectl --quiet || true
    //             gcloud container clusters get-credentials $CLUSTER_NAME --region $CLUSTER_LOCATION --project $PROJECT_ID
    //           '''
    //           env.GOOGLE_APPLICATION_CREDENTIALS = "${env.WORKSPACE}/sa.json"
    //           env.TF_VAR_google_credentials_path = "${env.WORKSPACE}/sa.json"
    //           env.TF_VAR_project_id = env.PROJECT_ID
    //         }
    //       }
    //     }
    //   }
    // }

    stage('Authenticate GCP') {
        steps {
            container('ci') {
            script {
                withCredentials([file(credentialsId: 'gcp-sa', variable: 'GCP_SA_JSON')]) {
                    sh '''#!/bin/bash
                        set -euxo pipefail
                        
                        # Revoke tất cả auth cũ để clear cache
                        gcloud auth revoke --all || true
                        
                        cp "$GCP_SA_JSON" ${WORKSPACE}/sa.json
                        export GOOGLE_APPLICATION_CREDENTIALS=${WORKSPACE}/sa.json
                        
                        # DEBUG: Kiểm tra SA đang dùng
                        echo "=== Checking service account ==="
                        cat ${WORKSPACE}/sa.json | grep client_email
                        
                        # Auth lại với SA mới
                        gcloud auth activate-service-account --key-file=${WORKSPACE}/sa.json
                        gcloud config set project $PROJECT_ID
                        
                        # DEBUG: Xác nhận SA đã auth
                        gcloud auth list
                        
                        # Test quyền đọc secret TRƯỚC KHI chạy Terraform
                        echo "=== Testing secret access ==="
                        gcloud secrets versions access latest --secret=gemini-api-key --project=$PROJECT_ID || {
                            echo "ERROR: Cannot access secrets!"
                            exit 1
                        }
                        
                        gcloud auth configure-docker ${REGION}-docker.pkg.dev --quiet
                        gcloud components install kubectl --quiet || true
                        gcloud container clusters get-credentials $CLUSTER_NAME --region $CLUSTER_LOCATION --project $PROJECT_ID
                    '''
                    env.GOOGLE_APPLICATION_CREDENTIALS = "${env.WORKSPACE}/sa.json"
                    env.TF_VAR_google_credentials_path = "${env.WORKSPACE}/sa.json"
                    env.TF_VAR_project_id = env.PROJECT_ID
                    }
                }
            }
        }
    }

    stage('Unit Tests') {
      steps {
        container('ci') {
          dir('backend') {
            sh '''#!/bin/bash
              set -euxo pipefail
              export PYTHONPATH=${PYTHONPATH:-}:$PWD
              python3 -m venv venv
              . venv/bin/activate
              pip install --upgrade pip
              if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
              if [ -d tests ]; then pytest tests; else echo 'No backend tests directory'; fi
            '''
          }
        }
      }
    }

    stage('Build & Push Backend Image') {
      steps {
        container('ci') {
          sh '''#!/bin/bash
            set -euxo pipefail
            export GOOGLE_APPLICATION_CREDENTIALS=${GOOGLE_APPLICATION_CREDENTIALS}

            BUILD_NAME=$(gcloud builds submit backend \
              --async \
              --format='value(name)' \
              --tag ${BACKEND_IMAGE_REPO}:${IMAGE_TAG} \
              --tag ${BACKEND_IMAGE_REPO}:latest \
              --project ${PROJECT_ID})

            if [ -z "${BUILD_NAME}" ]; then
              echo 'Khong lay duoc Cloud Build name'
              exit 1
            fi
            echo "Triggered Cloud Build: ${BUILD_NAME}"

            STATUS=''
            ATTEMPTS=0
            MAX_ATTEMPTS=60
            SLEEP_SECONDS=10

            while true; do
              STATUS=$(gcloud builds describe "${BUILD_NAME}" \
                --project ${PROJECT_ID} \
                --format='value(status)' 2>/dev/null || true)

              if [ "${STATUS}" = "SUCCESS" ]; then
                break
              fi

              if [ "${STATUS}" = "FAILURE" ] || [ "${STATUS}" = "CANCELLED" ] || \
                [ "${STATUS}" = "TIMEOUT" ] || [ "${STATUS}" = "EXPIRED" ]; then
                gcloud builds describe "${BUILD_NAME}" --project ${PROJECT_ID}
                exit 1
              fi

              ATTEMPTS=$((ATTEMPTS + 1))
              if [ ${ATTEMPTS} -ge ${MAX_ATTEMPTS} ]; then
                echo "Cloud Build chua hoan thanh sau $((ATTEMPTS * SLEEP_SECONDS)) giay"
                gcloud builds describe "${BUILD_NAME}" --project ${PROJECT_ID} || true
                exit 1
              fi

              STATUS_DISPLAY=${STATUS:-PENDING}
              echo "Cloud Build status: ${STATUS_DISPLAY}. Doi ${SLEEP_SECONDS}s..."
              sleep ${SLEEP_SECONDS}
            done
          '''
        }
      }
    }

    stage('Build & Push Frontend Image') {
      when { expression { fileExists('frontend/Dockerfile') } }
      steps {
        container('ci') {
          sh '''#!/bin/bash
            set -euxo pipefail
            export GOOGLE_APPLICATION_CREDENTIALS=${GOOGLE_APPLICATION_CREDENTIALS}

            BUILD_NAME=$(gcloud builds submit frontend \
              --async \
              --format='value(name)' \
              --tag ${FRONTEND_IMAGE_REPO}:${IMAGE_TAG} \
              --tag ${FRONTEND_IMAGE_REPO}:latest \
              --project ${PROJECT_ID})

            if [ -z "${BUILD_NAME}" ]; then
              echo 'Khong lay duoc Cloud Build name'
              exit 1
            fi
            echo "Triggered Cloud Build: ${BUILD_NAME}"

            STATUS=''
            ATTEMPTS=0
            MAX_ATTEMPTS=60
            SLEEP_SECONDS=10

            while true; do
              STATUS=$(gcloud builds describe "${BUILD_NAME}" \
                --project ${PROJECT_ID} \
                --format='value(status)' 2>/dev/null || true)

              if [ "${STATUS}" = "SUCCESS" ]; then
                break
              fi

              if [ "${STATUS}" = "FAILURE" ] || [ "${STATUS}" = "CANCELLED" ] || \
                [ "${STATUS}" = "TIMEOUT" ] || [ "${STATUS}" = "EXPIRED" ]; then
                gcloud builds describe "${BUILD_NAME}" --project ${PROJECT_ID}
                exit 1
              fi

              ATTEMPTS=$((ATTEMPTS + 1))
              if [ ${ATTEMPTS} -ge ${MAX_ATTEMPTS} ]; then
                echo "Cloud Build chua hoan thanh sau $((ATTEMPTS * SLEEP_SECONDS)) giay"
                gcloud builds describe "${BUILD_NAME}" --project ${PROJECT_ID} || true
                exit 1
              fi

              STATUS_DISPLAY=${STATUS:-PENDING}
              echo "Cloud Build status: ${STATUS_DISPLAY}. Doi ${SLEEP_SECONDS}s..."
              sleep ${SLEEP_SECONDS}
            done
          '''
        }
      }
    }

    stage('Terraform Init & Plan') {
        steps {
            container('ci') {
                dir('infra/terraform') {
                    sh '''#!/bin/bash
                        set -euxo pipefail
                        
                        # QUAN TRỌNG: Chỉ dùng GOOGLE_APPLICATION_CREDENTIALS (path)
                        export GOOGLE_APPLICATION_CREDENTIALS=${WORKSPACE}/sa.json
                        
                        # Verify SA identity (dùng grep thay vì jq)
                        echo "=== Terraform will use SA ==="
                        grep -o '"client_email": "[^"]*"' ${WORKSPACE}/sa.json | cut -d'"' -f4
                        
                        # Test lại secret access
                        echo "=== Testing secret access for Terraform ==="
                        gcloud secrets versions access latest --secret=gemini-api-key --project=$PROJECT_ID || {
                            echo "ERROR: SA cannot access secrets!"
                            exit 1
                        }
                        
                        terraform init -input=false
                        terraform plan -input=false \
                            -var="backend_image=${BACKEND_IMAGE_REPO}:${IMAGE_TAG}" \
                            -var="frontend_image=${FRONTEND_IMAGE_REPO}:${IMAGE_TAG}" \
                            -var="backend_replicas=${BACKEND_REPLICAS}" \
                            -var="frontend_replicas=${FRONTEND_REPLICAS}" \
                            -var="oauth2_replicas=${OAUTH2_REPLICAS}" \
                            -out=tfplan
                    '''
                }
            }
        }
    }

    stage('Approval') {
      when {
        branch 'main'
      }
      steps {
        timeout(time: 1, unit: 'HOURS') {
          input message: 'Triển khai Terraform apply?'
        }
      }
    }

    stage('Terraform Apply') {
        steps {
            container('ci') {
                dir('infra/terraform') {
                    sh '''#!/bin/bash
                        set -euxo pipefail
                        
                        # Chỉ cần export path đến SA key file
                        export GOOGLE_APPLICATION_CREDENTIALS=${WORKSPACE}/sa.json
                        
                        terraform apply -input=false -auto-approve tfplan
                    '''
                }
            }
        }
    }

    stage('Post-deploy Verification') {
      steps {
        container('ci') {
          sh '''#!/bin/bash
            set -euxo pipefail
            kubectl rollout status deployment/llm-backend -n llm-app --timeout=120s || true
            kubectl rollout status deployment/llm-frontend -n llm-app --timeout=120s || true
          '''
        }
      }
    }
  }

  post {
    always {
      container('ci') {
        sh 'rm -f ${WORKSPACE}/sa.json || true'
      }
      cleanWs()
    }
  }
}